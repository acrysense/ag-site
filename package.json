{
	"name": "vite-starter",
	"version": "1.0.0",
	"description": "A lean Vite starter for multi-page HTML/Handlebars projects.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.16.0"
	},
	"scripts": {
		"fonts": "node tools/build-fonts.mjs",
		"predev": "npm run fonts",
		"dev": "vite",
		"preui": "npm run fonts",
		"ui": "vite --open /dev/ui.html",
		"prebuild": "npm run fonts",
		"build": "vite build",
		"preview": "vite preview",
		"deploy:pages": "bash tools/deploy-pages.sh",
		"deploy:natix": "bash tools/deploy-natix.sh",
		"format": "prettier --write \"app/**/*.{scss,js,ts,json,md}\""
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"autoprefixer": "^10.6.1",
		"esbuild": "^0.28.2",
		"handlebars": "^4.7.9",
		"postcss": "^8.5.29",
		"prettier": "^3.9.9",
		"sass": "^1.105.1",
		"tinyglobby": "^0.2.17",
		"typescript": "^5.9.2",
		"vite": "^8.3.2"
	},
	"browserslist": {
		"production": [
			"chrome >= 107",
			"edge >= 107",
			"firefox >= 104",
			"safari >= 16",
			"ios_saf >= 16",
			"and_chr >= 107",
			"and_ff >= 104",
			"samsung >= 21",
			"opera >= 93"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"dependencies": {
		"photoswipe": "^5.4.4",
		"simplebar": "^6.3.3"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
