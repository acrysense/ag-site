{{!--
	Список документов (Figma: PC.Library 4526:83 — Frame 291; состояния 4531:543): белая карточка,
	заголовок — текущая папка и число документов, «Новые в начале» (SortMenu), выбранные фильтры
	чипами (× снимает один, «Сбросить всё»), шапка колонок и строки
	(DocumentRow), страницы и «Всего». Нет документов — сообщение и «Сбросить фильтры».
	Поле поиска (Figma: состояния 4532:794) на странице в макете не размещено — выводится, только
	если передан search; тогда в строках путь к папке и совпадение.
	До 1024 (наше) — кнопка «Фильтры · N» открывает панель фильтров (DocumentsFilters).
	props: title, count, sort (SortMenu), search { action, name («q»), value, label, placeholder,
	hidden [{ name, value }] }, foundText («Найдено: 2»), filtersId, filtersText, activeFilters
	(число выбранных), chips [{ text, url (адрес без этого фильтра) }], chipsResetUrl,
	chipsResetText, items [DocumentRow], empty { title, text, resetText, resetUrl }, pagination
	(Pagination). Контракт — docs/contracts/documents.md.
--}}
<section class="documents-list{{#if props.class}} {{props.class}}{{/if}}" aria-labelledby="{{default props.id 'documents-list'}}-title">
    <div class="documents-list__head">
        <h1 class="documents-list__title" id="{{default props.id 'documents-list'}}-title">
            {{props.title}}{{#if (isSet props.count)}} <span class="documents-list__count"><span class="visually-hidden">, документов: </span>{{props.count}}</span>{{/if}}
        </h1>
        {{> components/SortMenu/SortMenu props=props.sort}}
    </div>
    {{#if (or props.search props.filtersId)}}
        <div class="documents-list__tools">
            {{#if props.search}}
                <form class="documents-list__search" action="{{props.search.action}}" method="get" role="search">
                    {{#each props.search.hidden}}<input type="hidden" name="{{name}}" value="{{value}}" />{{/each}}
                    <label class="visually-hidden" for="{{default props.id 'documents-list'}}-q">{{default props.search.label "Поиск по документам"}}</label>
                    <button class="documents-list__search-submit" type="submit" aria-label="Найти">
                        {{> components/Icon/Icon name="search" class="documents-list__search-icon"}}
                    </button>
                    <input class="documents-list__search-input" id="{{default props.id 'documents-list'}}-q" type="search" name="{{default props.search.name 'q'}}" {{#if props.search.value}}value="{{props.search.value}}"{{/if}} placeholder="{{default props.search.placeholder 'Найти документ'}}" minlength="2" autocomplete="off" />
                </form>
            {{/if}}
            {{#if props.filtersId}}
                <button class="btn btn--light btn--m documents-list__filters" type="button" data-documents-filters-open="{{props.filtersId}}" aria-controls="{{props.filtersId}}" aria-expanded="false">{{default props.filtersText "Фильтры"}}{{#if props.activeFilters}} · {{props.activeFilters}}{{/if}}</button>
            {{/if}}
        </div>
    {{/if}}
    {{#if props.chips.length}}
        <ul class="documents-list__chips" role="list" aria-label="Выбранные фильтры">
            {{#each props.chips}}
                <li><a class="documents-list__chip" href="{{url}}">{{text}}<span class="visually-hidden"> — снять фильтр</span>{{> components/Icon/Icon name="close" class="documents-list__chip-icon"}}</a></li>
            {{/each}}
            {{#if props.chipsResetUrl}}<li><a class="documents-list__chips-reset" href="{{props.chipsResetUrl}}">{{default props.chipsResetText "Сбросить всё"}}</a></li>{{/if}}
        </ul>
    {{/if}}
    {{#if props.foundText}}<p class="documents-list__found" role="status">{{props.foundText}}</p>{{/if}}
    {{#if props.items.length}}
        <div class="documents-list__table">
            <div class="documents-list__columns" aria-hidden="true">
                <span></span>
                <span>Название</span>
                <span>Размер</span>
                <span>Обновлён</span>
                <span>Загрузил</span>
            </div>
            <ul class="documents-list__rows" role="list">
                {{#each props.items}}
                    {{> sections/documents/DocumentRow/DocumentRow props=this}}
                {{/each}}
            </ul>
        </div>
    {{else}}
        <div class="documents-list__empty">
            {{> components/Icon/Icon name="document" class="documents-list__empty-icon"}}
            <h2 class="documents-list__empty-title">{{default props.empty.title "Документы не найдены"}}</h2>
            {{#if props.empty.text}}<p class="documents-list__empty-text">{{props.empty.text}}</p>{{/if}}
            {{#if props.empty.resetUrl}}<a class="btn btn--general btn--m documents-list__empty-reset" href="{{props.empty.resetUrl}}">{{default props.empty.resetText "Сбросить фильтры"}}</a>{{/if}}
        </div>
    {{/if}}
    {{> components/Pagination/Pagination props=props.pagination}}
</section>
