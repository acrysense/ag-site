{{!--
	Фильтры библиотеки документов: флажки (Компания, FilterCheckbox) с числом документов
	и «Показать ещё N», «таблетки» годов, «Сбросить». Внутри группы — «ИЛИ», между группами —
	«И»; фильтр работает внутри текущей папки.
	С 1024 — карточка слева, выбор применяется сразу (GET-форма). До 1024 —
	панель на весь экран по кнопке «Фильтры · N» (data-documents-filters-open), выбор применяется
	кнопкой «Показать N документов», число пересчитывается на лету (countUrl).
	props: id, action, resetUrl, countUrl, countText («Показать 12 документов»), hidden [{ name,
	value }] — что сохранить в адресе (папка, сортировка, поиск), groups [{ title, name
	(«company[]»), variant («chips» — «таблетки», как годы), moreText («Показать ещё 3»), options
	[{ value, text, count, checked, extra }] }]. extra — пункт за «Показать ещё» (выбранные бэк не
	прячет); count 0 — пункт неактивный. static — витрина: на мобильном панель на месте.
	Контракт — docs/contracts/documents.md.
--}}
{{#if props.groups.length}}
    <form class="documents-filters{{#if props.static}} documents-filters--static{{/if}}{{#if props.class}} {{props.class}}{{/if}}" id="{{default props.id 'documents-filters'}}" action="{{props.action}}" method="get" aria-labelledby="{{default props.id 'documents-filters'}}-title" data-module="DocumentsFilters" data-path="sections/documents" {{#if props.countUrl}}data-count-url="{{props.countUrl}}"{{/if}}>
        {{#each props.hidden}}<input type="hidden" name="{{name}}" value="{{value}}" />{{/each}}
        <div class="documents-filters__head">
            <h2 class="documents-filters__title" id="{{default props.id 'documents-filters'}}-title">{{default props.title "Фильтры"}}</h2>
            {{#if props.resetUrl}}<a class="documents-filters__reset" href="{{props.resetUrl}}">{{default props.resetText "Сбросить"}}</a>{{/if}}
            <button class="documents-filters__close" type="button" aria-label="Закрыть фильтры" data-documents-filters-close>
                {{> components/Icon/Icon name="close" class="documents-filters__close-icon"}}
            </button>
        </div>
        <div class="documents-filters__body">
            {{#with (default props.id 'documents-filters') as |fid|}}
                {{#each ../props.groups as |group gi|}}
                    <fieldset class="documents-filters__group">
                        <legend class="documents-filters__legend">{{group.title}}</legend>
                        {{#if (eq group.variant "chips")}}
                            <ul class="documents-filters__chips" role="list">
                                {{#each group.options as |option oi|}}
                                    <li>
                                        <label class="documents-filters__chip{{#if (eq option.count 0)}} is-disabled{{/if}}" for="{{concat fid '-' gi '-' oi}}">
                                            <input class="documents-filters__chip-input" type="checkbox" id="{{concat fid '-' gi '-' oi}}" name="{{group.name}}" value="{{option.value}}" {{#if option.checked}}checked{{/if}} {{#if (eq option.count 0)}}disabled{{/if}} />
                                            {{option.text}}{{#if (isSet option.count)}}<span class="visually-hidden">, документов: {{option.count}}</span>{{/if}}
                                        </label>
                                    </li>
                                {{/each}}
                            </ul>
                        {{else}}
                            <ul class="documents-filters__options" role="list">
                                {{#each group.options as |option oi|}}
                                    <li {{#if option.extra}}hidden data-filter-extra{{/if}}>
                                        {{> components/FilterCheckbox/FilterCheckbox props=(obj id=(concat fid '-' gi '-' oi) name=group.name value=option.value text=option.text count=option.count countLabel="документов" checked=option.checked disabled=(eq option.count 0))}}
                                    </li>
                                {{/each}}
                            </ul>
                            {{#if group.moreText}}<button class="documents-filters__more" type="button" data-filter-more>{{group.moreText}}</button>{{/if}}
                        {{/if}}
                    </fieldset>
                {{/each}}
            {{/with}}
            <noscript><button class="btn btn--light btn--m" type="submit">Показать</button></noscript>
        </div>
        <div class="documents-filters__actions">
            {{#if props.resetUrl}}<a class="btn btn--light btn--m" href="{{props.resetUrl}}">{{default props.resetText "Сбросить"}}</a>{{/if}}
            <button class="btn btn--general btn--m documents-filters__submit" type="submit" data-documents-filters-count>{{default props.countText "Показать документы"}}</button>
        </div>
    </form>
{{/if}}
