{{!--
	Сброс пароля: телефон, «Вернуться к форме входа», «Отправить код». Обычная POST-форма
	(компонент Битрикса); пустое поле и формат номера проверяет модуль Form, «номер не найден» —
	сервер (error — под полем).
	props: id (префикс id полей, по умолчанию auth), action, hidden, fields { phone, phonePlaceholder, phoneName }, phone (введённый номер),
	back { text, url }, error, submit; card (AuthCard). Контракт — docs/contracts/auth.md.
--}}
{{#with props as |form|}}
    {{#> sections/auth/AuthCard/AuthCard props=form.card}}
        <form class="auth-form" action="{{form.action}}" method="post" data-module="Form" data-path="components" data-form-native>
            {{#each form.hidden}}<input type="hidden" name="{{name}}" value="{{value}}" />{{/each}}
            <div class="auth-form__fields">
                {{> components/Field/Field props=(obj id=(concat (default form.id "auth") "-phone") name=(default form.fields.phoneName "phone") type="tel" label=form.fields.phone labelHidden=true placeholder=form.fields.phonePlaceholder autocomplete="tel" inputmode="tel" required=true maxlength=25 error=form.error value=form.phone link=form.back)}}
            </div>
            <p class="form-error" role="alert" data-form-error hidden></p>
            {{> components/Button/Button props=(obj text=(default form.submit "Отправить код") variant="general" size="m" type="submit" class="auth-form__submit")}}
        </form>
    {{/sections/auth/AuthCard/AuthCard}}
{{/with}}
