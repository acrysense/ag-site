{{!--
	Юрлица холдинга — белый блок («остров»): заголовок H1 и число юрлиц рядом, сетка карточек
	EntityCard — с 1280 по 3 в ряд, с 768 по 2, на телефоне по одной.
	props: title, count (число рядом с заголовком; нет — без него), items [EntityCard]. Пусто — блока нет.
--}}
{{#if props.items.length}}
    <section class="holding-entities" aria-labelledby="holding-entities-title">
        <h2 class="holding-entities__title" id="holding-entities-title">
            {{default props.title "Юридические лица холдинга"}}
            {{#if props.count}}<span class="holding-entities__count">{{props.count}}</span>{{/if}}
        </h2>
        <ul class="holding-entities__grid" role="list">
            {{#each props.items}}
                <li class="holding-entities__item">{{> sections/holding/EntityCard/EntityCard props=this}}</li>
            {{/each}}
        </ul>
    </section>
{{/if}}
