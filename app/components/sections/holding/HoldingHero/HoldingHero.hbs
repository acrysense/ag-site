{{!--
	Шапка «Структуры холдинга» (компактная): слева заголовок H0 и подзаголовок, справа на уровне
	заголовка — переключатель вида «По управлению / По юрлицам» (ссылки на страницы, текущая —
	aria-current). До 1024 переключатель — под заголовком.
	props: title, subtitle, views [{ text, url, current }]. Нет views — блок без переключателя.
--}}
<section class="holding-hero" aria-labelledby="holding-hero-title">
    <div class="holding-hero__intro">
        <h1 class="holding-hero__title" id="holding-hero-title">{{props.title}}</h1>
        {{#if props.subtitle}}<p class="holding-hero__subtitle">{{props.subtitle}}</p>{{/if}}
    </div>
    {{#if props.views.length}}
        {{> components/Tabs/Tabs props=(obj links=props.views label=(default props.viewsLabel "Вид структуры холдинга") class="tabs--light holding-hero__views")}}
    {{/if}}
</section>
