{{!--
	Карточка юрлица (внутри белого блока): название H3, телефон, адрес и число аптек, бренды
	(плашки), внизу «Подробнее» — страница юрлица.
	props: name, url, phones [{ text, url }], address, pharmacies (число аптек; нет — без строки),
	brands [{ name, logo }], brandsLabel, brandsPending — бренды ещё не заданы (пунктирная плашка
	«Бренды уточняются»; нет брендов и не pending — без блока брендов), moreText.
	Карточки ряда одной высоты — «Подробнее» прижата к низу.
--}}
<article class="entity-card">
    <div class="entity-card__top">
        <h3 class="entity-card__title">{{props.name}}</h3>
        {{> sections/holding/InfoList/InfoList props=(obj items=(arr (obj label="Телефон:" links=props.phones) (obj label="Адрес:" value=props.address) (obj label="Аптек:" value=props.pharmacies)) aligned=true)}}
        {{#if (or props.brands.length props.brandsPending)}}
            {{> sections/holding/BrandChips/BrandChips props=(obj label=props.brandsLabel items=props.brands class="brand-chips--white")}}
        {{/if}}
    </div>
    <a class="btn btn--general btn--m entity-card__more" href="{{props.url}}">{{default props.moreText "Подробнее"}}<span class="visually-hidden">: {{props.name}}</span></a>
</article>
