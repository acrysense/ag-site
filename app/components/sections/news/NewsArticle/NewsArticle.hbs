{{!--
	Новость (Figma: PC.News article v2 — 4652:12003). props: title, image { src, srcset, alt,
	caption } — обложка, html — текст из визуального редактора (как есть), gallery (Gallery),
	date (YYYY-MM-DD), dateText, url (адрес новости — для «Скопировать ссылку»), comments
	{ count, anchor }, like (LikeButton: count, liked, url).
	Мобильного макета нет — наше. Контракт — docs/contracts/news-article.md.
--}}
<article class="news-article" aria-labelledby="news-article-title">
    <h1 class="news-article__title" id="news-article-title">{{props.title}}</h1>
    {{#if props.image.src}}
        <figure class="news-article__cover">
            <img class="news-article__image" src="{{props.image.src}}" {{#if props.image.srcset}}srcset="{{props.image.srcset}}" sizes="(min-width: 1024px) 1040px, 100vw"{{/if}} width="1040" height="341" alt="{{props.image.alt}}" decoding="async" />
            {{#if props.image.caption}}<figcaption class="news-article__caption">{{props.image.caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}
    {{#if props.html}}<div class="content news-article__content" data-module="Content" data-path="components">{{{props.html}}}</div>{{/if}}
    {{> components/Gallery/Gallery props=props.gallery}}
    <footer class="news-article__footer">
        <div class="news-article__actions">
            <button class="btn btn--light btn--s news-article__share" type="button" aria-label="Скопировать ссылку на новость" data-copy-link="{{props.url}}" data-module="CopyLink" data-path="components">
                {{> components/Icon/Icon name="link" class="btn__icon"}}
                {{!-- После копирования раскрывается вправо поверх соседних кнопок (скринридеру — объявление) --}}
                <span class="news-article__copied" aria-hidden="true">{{> components/Icon/Icon name="check" class="btn__icon news-article__copied-icon"}}{{default props.copiedText "Скопировано"}}</span>
            </button>
            {{#if props.comments}}
                {{> components/Button/Button props=(obj href=(default props.comments.anchor '#comments') icon="comment" hiddenText="Комментарии: " text=props.comments.count variant="light" size="s")}}
            {{/if}}
            {{#if props.like}}{{> components/LikeButton/LikeButton props=props.like}}{{/if}}
        </div>
        {{#if props.date}}<time class="news-article__date" datetime="{{props.date}}">{{props.dateText}}</time>{{/if}}
    </footer>
</article>
