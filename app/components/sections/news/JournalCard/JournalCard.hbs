{{!--
	Выпуск журнала: обложка 1:1, дата,
	название, кнопки «Читать», «Скачать · 1.2 ГБ», «Нравится». Вся карточка ведёт на «Читать»,
	кнопки — поверх. Контракт — docs/contracts/journal.md.
	props: title, readUrl, file { url, sizeText, name }, image { src, srcset, width, height },
	date (YYYY-MM-DD), dateText, likes, liked, likeUrl.
--}}
<article class="journal-card">
    <div class="journal-card__cover">
        {{#if props.image.src}}
            <img class="journal-card__image" src="{{props.image.src}}" {{#if props.image.srcset}}srcset="{{props.image.srcset}}" sizes="(min-width: 1280px) 360px, (min-width: 768px) 30vw, 50vw"{{/if}} width="{{default props.image.width 360}}" height="{{default props.image.height 360}}" alt="" loading="lazy" decoding="async" />
        {{/if}}
    </div>
    <div class="journal-card__text">
        {{#if props.date}}<time class="journal-card__date" datetime="{{props.date}}">{{props.dateText}}</time>{{/if}}
        <h3 class="journal-card__title"><a class="journal-card__link" href="{{props.readUrl}}">{{props.title}}</a></h3>
    </div>
    <div class="journal-card__actions">
        {{#if props.readUrl}}
            {{> components/Button/Button props=(obj href=props.readUrl icon="book" hiddenText=(concat "Читать: " props.title) variant="light" size="s" class="journal-card__read")}}
        {{/if}}
        {{#if props.file.url}}
            {{> components/Button/Button props=(obj href=props.file.url download=true icon="download" hiddenText=(concat "Скачать «" props.title "», ") text=props.file.sizeText variant="light" size="s" class="journal-card__download")}}
        {{/if}}
        {{> components/LikeButton/LikeButton props=(obj count=props.likes liked=props.liked url=props.likeUrl)}}
    </div>
</article>
