{{!--
	Комментарии — дерево с ответами и реакциями (Figma: 4494:780 — компоненты и состояния,
	4652:12134 — на странице новости). Общий блок: новости, позже визиты и задачи.
	Оболочку выводит бэк, дерево рисует скрипт по JSON-API (docs/contracts/comments.md).
	props: id (якорь, по умолчанию comments), title, count, url (API), entity, entityId,
	limit (верхний уровень за раз, по умолчанию 8), initial — первая порция в формате ответа
	API: с ней дерево видно сразу, без запроса и скелетона; без неё — загрузка, когда блок
	близко к экрану.
--}}
<section
    class="comments"
    id="{{default props.id 'comments'}}"
    aria-labelledby="{{default props.id 'comments'}}-title"
    data-module="Comments"
    data-path="sections/shared"
    data-comments-url="{{props.url}}"
    data-entity="{{props.entity}}"
    data-entity-id="{{props.entityId}}"
    data-limit="{{default props.limit 8}}"
>
    <h2 class="comments__title" id="{{default props.id 'comments'}}-title">
        {{default props.title "Комментарии"}}
        <span class="comments__count" data-comments-count>{{#if props.count}}{{props.count}}{{/if}}</span>
    </h2>
    <div class="comments__composer" data-comments-composer></div>
    <div class="comments__list" data-comments-list>
        {{#unless props.initial}}
            <div class="comments__skeleton" aria-hidden="true">
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
                <span></span><span></span><span></span>
            </div>
        {{/unless}}
    </div>
    <p class="comments__status" data-comments-status hidden></p>
    <button class="btn comments__more" type="button" data-comments-more hidden>Показать ещё комментарии</button>
    <noscript><p class="comments__status">Чтобы читать и писать комментарии, включите JavaScript.</p></noscript>
    {{#if props.initial}}<script type="application/json" data-comments-initial>{{{json props.initial}}}</script>{{/if}}
</section>
