{{!--
	Баннеры главной (Figma: 1920 — 4615:42835, 360 — 4865:1335): слайдер и промо справа.
	props: slides [{ url, alt, image: { desktop, mobile }, video: { src, poster } }], promos [{ url, alt, image: { desktop, mobile } }],
	autoplay — автолистание слайдера, секунды (по умолчанию 5; 0 — выключено).
	Слайды и промо на десктопе — 2.2:1, картинки взаимозаменяемы; мобильная картинка промо
	необязательна (нет — десктопная целиком).
	ТЗ: слайдер — смесь картинок и видео. Видео без звука, по кругу; при «уменьшить движение»
	не запускается само (постер).
	Текст баннеров — в самих картинках, поэтому alt обязателен (его заполняет админ).
	Нет промо — слайдер во всю ширину; один слайд — без стрелок и точек; нет ничего — блок
	не выводится. Контракт — docs/contracts/hero-banners.md.
--}}
{{#if (or props.slides.length props.promos.length)}}
    <section class="hero{{#unless props.promos.length}} hero--no-promos{{/unless}}{{#unless props.slides.length}} hero--no-slides{{/unless}}" aria-label="{{default props.label 'Баннеры'}}">
        {{#if props.slides.length}}
            <div class="hero__slider carousel carousel--parallax" role="region" aria-roledescription="карусель" aria-label="Баннеры" data-module="Carousel" data-path="components" data-carousel-loop data-carousel-autoplay="{{default props.autoplay 5}}">
                <div class="carousel__track hero__track" data-carousel-track>
                    {{#each props.slides}}
                        <div class="carousel__slide hero__slide" role="group" aria-roledescription="слайд" aria-label="{{add @index 1}} из {{../props.slides.length}}">
                            {{#if url}}<a class="hero__slide-link" href="{{url}}">{{/if}}
                            {{#if video}}
                                <video class="hero__image" src="{{video.src}}" {{#if video.poster}}poster="{{video.poster}}"{{/if}} muted loop playsinline preload="metadata" aria-label="{{alt}}" data-hero-video></video>
                            {{else}}
                                <picture class="hero__picture">
                                    {{#if image.desktop}}<source media="(min-width: 768px)" srcset="{{image.desktop}}" />{{/if}}
                                    <img class="hero__image" src="{{default image.mobile image.desktop}}" width="1100" height="500" alt="{{alt}}" {{#unless @first}}loading="lazy"{{/unless}} decoding="async" />
                                </picture>
                            {{/if}}
                            {{#if url}}</a>{{/if}}
                        </div>
                    {{/each}}
                </div>
                {{!-- Один слайд — листать нечего: стрелок и точек нет в разметке --}}
                {{#if props.slides.[1]}}
                    <button class="hero__arrow hero__arrow--prev" type="button" aria-label="Предыдущий баннер" data-carousel-prev>
                        {{> components/Icon/Icon name="angle-right" class="hero__arrow-icon"}}
                    </button>
                    <button class="hero__arrow hero__arrow--next" type="button" aria-label="Следующий баннер" data-carousel-next>
                        {{> components/Icon/Icon name="angle-right" class="hero__arrow-icon"}}
                    </button>
                    <div class="carousel__dots hero__dots" data-carousel-dots></div>
                {{/if}}
            </div>
        {{/if}}
        {{#if props.promos.length}}
            <ul class="hero__promos" role="list">
                {{#each props.promos}}
                    <li class="hero__promo-item">
                        {{#if url}}<a class="hero__promo{{#if image.mobile}} hero__promo--has-mobile{{/if}}" href="{{url}}">{{else}}<div class="hero__promo{{#if image.mobile}} hero__promo--has-mobile{{/if}}">{{/if}}
                        <picture class="hero__promo-picture">
                            {{#if image.mobile}}<source media="(min-width: 768px)" srcset="{{image.desktop}}" />{{/if}}
                            <img class="hero__promo-image" src="{{default image.mobile image.desktop}}" alt="{{alt}}" decoding="async" />
                        </picture>
                        {{#if url}}</a>{{else}}</div>{{/if}}
                    </li>
                {{/each}}
            </ul>
        {{/if}}
    </section>
{{/if}}
