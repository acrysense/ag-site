{{!--
	Список публикаций с превью: «Акции», «Корпоративные новости» (Figma: 1920 — 4615:42853,
	360 — 4865:1354). props: title, url (ссылка на раздел), items [{ url, title, image }].
	На десктопе по 4 пункта на странице, стрелки листают страницы (если пунктов больше 4);
	на мобильном — первые 4, без стрелок. Нет картинки — на её месте заготовка, строки
	выровнены. Пусто — блок не выводится. Контракт — docs/contracts/post-list.md.
--}}
{{#if props.items.length}}
    {{#with (chunk props.items 4) as |pages|}}
        <section class="post-list carousel" data-module="Carousel" data-path="components" data-carousel-loop>
            <div class="post-list__head">
                <h2 class="post-list__title">{{#if ../props.url}}<a href="{{../props.url}}">{{../props.title}}</a>{{else}}{{../props.title}}{{/if}}</h2>
                {{#if pages.[1]}}
                    <div class="post-list__arrows">
                        <button class="post-list__arrow" type="button" aria-label="Предыдущие: {{../props.title}}" data-carousel-prev>
                            {{> components/Icon/Icon name="arrow-left" class="post-list__arrow-icon"}}
                        </button>
                        <button class="post-list__arrow post-list__arrow--next" type="button" aria-label="Следующие: {{../props.title}}" data-carousel-next>
                            {{> components/Icon/Icon name="arrow-left" class="post-list__arrow-icon"}}
                        </button>
                    </div>
                {{/if}}
            </div>
            <div class="carousel__track post-list__track" data-carousel-track>
                {{#each pages}}
                    <ul class="carousel__slide post-list__page" role="list">
                        {{#each this}}
                            <li class="post-list__item">
                                <a class="post-list__link" href="{{url}}">
                                    <span class="post-list__thumb">{{#if image}}<img class="post-list__image" src="{{image}}" width="80" height="80" alt="" loading="lazy" decoding="async" />{{/if}}</span>
                                    <span class="post-list__text">{{title}}</span>
                                </a>
                            </li>
                        {{/each}}
                    </ul>
                {{/each}}
            </div>
        </section>
    {{/with}}
{{/if}}
