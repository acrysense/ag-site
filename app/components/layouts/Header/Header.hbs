{{!--
	Шапка сайта (Figma: PC.HEADER.v2 — 4652:8752, 360.HEADER — 4865:1334).
	props: id, homeUrl, title (полное название), titleShort (мобильное), search (см. SearchField),
	menu — пункты [{ text, url, current, children: [{ text, url, current }] }],
	user — для вошедшего: { name, initials, avatar, url, links: [{ icon, label, url }] }
	(links — быстрые ссылки на десктопе: личный кабинет, учебный портал, CRM),
	иначе кнопка входа: loginUrl, loginText.
	Контракт — docs/contracts/header.md.
--}}
<header class="header" data-module="Header" data-path="layouts">
    <div class="header__top">
        <a class="header__brand" href="{{default props.homeUrl '/'}}">
            <picture class="header__logo">
                <source media="(min-width: 1024px)" srcset="/assets/images/logo.svg" width="57" height="52" />
                <img src="/assets/images/logo-mobile.svg" width="40" height="40" alt="" />
            </picture>
            <span class="header__title header__title--full">{{props.title}}</span>
            <span class="header__title header__title--short">{{default props.titleShort props.title}}</span>
        </a>

        {{> components/SearchField/SearchField props=(obj action=props.search.action name=props.search.name placeholder=props.search.placeholder id=(default props.id 'header') class="header__search")}}

        <div class="header__actions">
            {{#if props.user}}
                {{#if props.user.links}}
                    <ul class="header__quick" role="list">
                        {{#each props.user.links}}
                            <li>
                                <a class="header__quick-link" href="{{url}}" title="{{label}}">
                                    <span class="visually-hidden">{{label}}</span>
                                    {{> components/Icon/Icon name=icon class="header__quick-icon"}}
                                </a>
                            </li>
                        {{/each}}
                    </ul>
                {{/if}}
                {{!-- Меню под аватаром в макете не нарисовано: пока ссылка на личный кабинет --}}
                <a class="header__user" href="{{props.user.url}}">
                    <span class="header__avatar">
                        {{#if props.user.avatar}}
                            <img src="{{props.user.avatar}}" width="30" height="30" alt="" />
                        {{else}}
                            <span class="header__initials" aria-hidden="true">{{props.user.initials}}</span>
                        {{/if}}
                    </span>
                    <span class="header__user-name">{{props.user.name}}</span>
                    {{> components/Icon/Icon name="angle-right" class="header__user-arrow"}}
                </a>
            {{else}}
                {{> components/Button/Button props=(obj href=props.loginUrl text=(default props.loginText 'Войти в ЛК') variant="general" size="m" class="header__login")}}
            {{/if}}
            <button class="header__burger" type="button" aria-expanded="false" aria-controls="main-menu" data-main-menu-open>
                <span class="visually-hidden">Меню</span>
                {{> components/Icon/Icon name="menu" class="header__burger-icon"}}
            </button>
        </div>
    </div>

    <nav class="header__nav" aria-label="Основное меню">
        <ul class="menu" role="list">
            {{#each props.menu}}
                <li class="menu__item" {{#if children}}data-submenu{{/if}}>
                    <a class="menu__link" href="{{url}}" {{#if current}}aria-current="page"{{/if}}>{{text}}</a>
                    {{#if children}}
                        <button class="menu__toggle" type="button" aria-expanded="false" aria-controls="{{default ../props.id 'header'}}-submenu-{{@index}}" data-submenu-toggle>
                            <span class="visually-hidden">Подменю «{{text}}»</span>
                            {{> components/Icon/Icon name="arrow-down-small" class="menu__arrow"}}
                        </button>
                        <ul class="menu__submenu" id="{{default ../props.id 'header'}}-submenu-{{@index}}" role="list" hidden>
                            {{#each children}}
                                <li><a class="menu__sublink" href="{{url}}" {{#if current}}aria-current="page"{{/if}}>{{text}}</a></li>
                            {{/each}}
                        </ul>
                    {{/if}}
                </li>
            {{/each}}
        </ul>
    </nav>
</header>
