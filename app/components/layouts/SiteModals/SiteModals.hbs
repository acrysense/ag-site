{{!--
	Общие окна страницы — подключаются один раз в каждом шаблоне после подвала.
	props (site.modals): discard { title, text, confirm, cancel } — подтверждение закрытия
	изменённой формы; suggest { id, title, text, action, fields…, success { … } } — «Предложить
	тему».
	Контракт — docs/contracts/form.md.
--}}
{{#with props.discard}}
    {{!-- Внутри блока модалки props — её собственные параметры, поэтому данные через with --}}
    {{#> components/Modal/Modal props=(obj id="modal-discard" title=title text=text size="s" variant="confirm" close=false discard=true)}}
        <div class="modal__actions">
            {{> components/Button/Button props=(obj text=confirm variant="error" size="l" attrs=(obj data-modal-discard-confirm=""))}}
            {{> components/Button/Button props=(obj text=cancel variant="light" size="l" attrs=(obj data-modal-close="" autofocus=""))}}
        </div>
    {{/components/Modal/Modal}}
{{/with}}
{{#with props.suggest}}
    {{#> components/Modal/Modal props=(obj id=id title=title size="l")}}
        {{> layouts/SiteModals/SuggestForm}}
    {{/components/Modal/Modal}}
    {{#> components/Modal/Modal props=(obj id=(concat id "-success") title=success.title text=success.text variant="center" icon="success")}}
        {{> components/Button/Button props=(obj text=success.close variant="general" size="m" attrs=(obj data-modal-close=""))}}
    {{/components/Modal/Modal}}
{{/with}}
