{{#each baseMeta}}
    <meta {{{attrs this}}} />
{{/each}}

<title>{{head.title}}</title>

<meta name="description" content="{{or head.description site.seoDefaults.description}}" />

{{#each meta}}
    <meta {{{attrs this}}} />
{{/each}}

{{#each linkPreload}}
    <link {{{attrs this}}} />
{{/each}}

{{#each linkOther}}
    <link {{{attrs this}}} />
{{/each}}

{{#if page.canonical}}
    <link rel="canonical" href="{{page.canonical}}" />
{{/if}}

{{!-- Превью ссылки (Telegram, VK, мессенджеры): адреса страницы и картинки — полные.
На бэке — из SEO-модуля Битрикса; картинка по умолчанию — /og-default.jpg (1200×630) --}}
<meta property="og:type" content="{{or head.ogType 'website'}}" />
{{#if page.canonical}}
    <meta property="og:url" content="{{page.canonical}}" />
{{/if}}
<meta property="og:locale" content="{{or site.ogLocale 'ru_RU'}}" />
<meta property="og:site_name" content="{{or site.siteName head.title}}" />
<meta property="og:title" content="{{or head.title site.siteName}}" />
<meta property="og:description" content="{{or head.description site.seoDefaults.description}}" />
{{#if head.ogImage}}
    <meta property="og:image" content="{{head.ogImage}}" />
    <meta property="og:image:width" content="{{or head.ogImageWidth 1200}}" />
    <meta property="og:image:height" content="{{or head.ogImageHeight 630}}" />
    <meta property="og:image:alt" content="{{or head.title site.siteName}}" />
{{/if}}

<meta name="twitter:card" content="{{or head.twitterCard 'summary_large_image'}}" />
<meta name="twitter:title" content="{{or head.title site.siteName}}" />
<meta name="twitter:description" content="{{or head.description site.seoDefaults.description}}" />
{{#if head.ogImage}}
    <meta name="twitter:image" content="{{head.ogImage}}" />
{{/if}}

{{!-- Демо и dev: имитация сервера (поиск в шапке, комментарии, фильтры) — в сборке для CMS её нет --}}
{{#if @root.demo}}<script type="module" src="/pages/dev/mock-server.js"></script>{{/if}}
{{!-- Демо: «счётчик», который ждёт согласия на cookie (CookieBanner включит его после «Принять») --}}
{{#if @root.demo}}<script type="text/plain" data-cookie-consent>window.__agDemoCounter = (window.__agDemoCounter || 0) + 1; console.info('[demo] счётчик включён после согласия на cookie')</script>{{/if}}
