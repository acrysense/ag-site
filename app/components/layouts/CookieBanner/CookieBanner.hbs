{{!--
	Согласие на cookie (Figma: 4711:32225 — «Cookie consent — Light», 420). Не модальное окно:
	левый нижний угол, без затемнения, фокус не перехватывает — сайтом можно пользоваться.
	На мобильном — во всю ширину над нижней навигацией. Выбор сохраняется в cookie на год;
	бэк не выводит баннер, если cookie уже есть. В разметке баннер скрыт (hidden): показывает
	скрипт, когда выбора ещё нет, — иначе при перезагрузке он мелькал бы до запуска скрипта.
	Контракт — docs/contracts/cookie-banner.md.
	props (site.cookies): name (имя cookie), title, text, link { text, url }, accept, decline,
	static — показать на месте (витрина).
--}}
{{#if props.title}}
    <section class="cookie-banner{{#if props.static}} cookie-banner--static{{/if}}" aria-labelledby="cookie-banner-title" data-module="CookieBanner" data-path="layouts" data-cookie-name="{{default props.name 'ag_cookie_consent'}}"{{#unless props.static}} hidden{{/unless}}>
        <h2 class="cookie-banner__title" id="cookie-banner-title">{{props.title}}</h2>
        <p class="cookie-banner__text">
            {{props.text}}
            {{#if props.link}}<br /><a class="cookie-banner__link" href="{{props.link.url}}">{{props.link.text}}</a>{{/if}}
        </p>
        <div class="cookie-banner__actions">
            {{> components/Button/Button props=(obj text=(default props.accept "Принять") variant="general" size="m" attrs=(obj data-cookie-choice="accepted"))}}
            {{> components/Button/Button props=(obj text=(default props.decline "Отклонить") variant="light" size="m" attrs=(obj data-cookie-choice="declined"))}}
        </div>
    </section>
{{/if}}
