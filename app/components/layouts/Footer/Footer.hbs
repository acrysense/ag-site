{{!--
	Подвал.
	props: slogan, social [{ icon, label, text, url }], contacts [{ icon, text, url }],
	suggest { text, url, modal — id окна; без JS ссылка ведёт на url }, copyright, legal [{ text, url }]. Данные — site.footer.
	Контракт — docs/contracts/footer.md.
--}}
<footer class="footer">
    <div class="footer__inner">
        <div class="footer__row footer__row--brand">
            <p class="footer__slogan">{{props.slogan}}</p>
            {{#if props.social}}
                <ul class="footer__social" role="list">
                    {{#each props.social}}
                        <li>
                            <a class="footer__social-link" href="{{url}}" target="_blank" rel="noopener noreferrer">
                                <span class="footer__social-icon">{{> components/Icon/Icon name=icon class="footer__social-svg"}}</span>
                                {{#if text}}
                                    <span class="footer__social-text">{{text}}</span>
                                    <span class="visually-hidden"> — {{label}}, откроется в новой вкладке</span>
                                {{else}}
                                    <span class="visually-hidden">{{label}}, откроется в новой вкладке</span>
                                {{/if}}
                            </a>
                        </li>
                    {{/each}}
                </ul>
            {{/if}}
        </div>

        <div class="footer__row footer__row--contacts">
            {{#if props.contacts}}
                <ul class="footer__contacts" role="list">
                    {{#each props.contacts}}
                        <li>
                            <a class="footer__contact" href="{{url}}">
                                {{> components/Icon/Icon name=icon class="footer__contact-icon"}}
                                <span>{{text}}</span>
                            </a>
                        </li>
                    {{/each}}
                </ul>
            {{/if}}
            {{#if props.suggest}}
                {{> components/Button/Button props=(obj href=props.suggest.url text=props.suggest.text variant="general" size="m" class="footer__suggest" attrs=(obj data-modal-open=props.suggest.modal))}}
            {{/if}}
        </div>

        <div class="footer__row footer__row--legal">
            <p class="footer__copyright">{{props.copyright}}</p>
            {{#if props.legal}}
                <ul class="footer__legal" role="list">
                    {{#each props.legal}}
                        <li><a class="footer__legal-link" href="{{url}}">{{text}}</a></li>
                    {{/each}}
                </ul>
            {{/if}}
        </div>
    </div>
</footer>
