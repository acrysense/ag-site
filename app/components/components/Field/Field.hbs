{{!--
	Поле формы — однострочное или многострочное (например, форма «Предложить тему»).
	props: id, name, label, labelHidden (подпись только для скринридера — когда видимой подписи
	нет, есть подсказка), type (text, email, tel…), multiline (многострочное), placeholder,
	value, required, autocomplete, inputmode, maxlength, maxRows (многострочное растёт до стольких
	строк, дальше текст не вводится — прокрутки внутри нет; по умолчанию 8), class.
	reveal — у пароля «глаз» показать/скрыть; hint — подсказка под
	полем; link { text, url } — ссылка под полем («Не удается войти?»); error — ошибка с сервера
	(страница пришла после отправки): поле сразу красное, текст под ним; invalid — только красная
	рамка (текст ошибки — общий, над кнопкой).
	Многострочное не растягивается мышью — растёт по высоте само (utils/autosize.js).
	Длину ограничивает maxlength, лишние пробелы и пустые строки чистит модуль Form.
	Ошибку под полем выводит модуль Form: цвет, значок и текст, aria-invalid и aria-describedby.
--}}
<div class="field{{#if props.multiline}} field--multiline{{/if}}{{#if props.reveal}} field--reveal{{/if}}{{#if (or props.error props.invalid)}} is-invalid{{/if}}{{#if props.class}} {{props.class}}{{/if}}" {{#if props.reveal}}data-module="Field" data-path="components"{{/if}}>
    <label class="field__label{{#if props.labelHidden}} visually-hidden{{/if}}" for="{{props.id}}">{{props.label}}</label>
    {{#if props.multiline}}
        <textarea class="field__control" id="{{props.id}}" name="{{props.name}}" rows="3" data-autosize data-autosize-max-rows="{{default props.maxRows 8}}" {{#if props.placeholder}}placeholder="{{props.placeholder}}"{{/if}} {{#if props.required}}required{{/if}} {{#if props.maxlength}}maxlength="{{props.maxlength}}"{{/if}}>{{props.value}}</textarea>
    {{else}}
        <span class="field__box">
            <input class="field__control" id="{{props.id}}" name="{{props.name}}" type="{{default props.type 'text'}}" {{#if props.value}}value="{{props.value}}"{{/if}} {{#if props.placeholder}}placeholder="{{props.placeholder}}"{{/if}} {{#if props.autocomplete}}autocomplete="{{props.autocomplete}}"{{/if}} {{#if props.inputmode}}inputmode="{{props.inputmode}}"{{/if}} {{#if props.required}}required{{/if}} {{#if props.maxlength}}maxlength="{{props.maxlength}}"{{/if}} {{#if (or props.error props.invalid)}}aria-invalid="true"{{/if}} {{#if (or props.hint props.error)}}aria-describedby="{{#if props.hint}}{{props.id}}-hint{{/if}}{{#if props.error}} {{props.id}}-error{{/if}}"{{/if}} />
            {{#if props.reveal}}
                <button class="field__reveal" type="button" aria-label="Показать пароль" aria-pressed="false" aria-controls="{{props.id}}" data-field-reveal>
                    {{> components/Icon/Icon name="eye" class="field__reveal-icon field__reveal-icon--show"}}
                    {{> components/Icon/Icon name="eye-off" class="field__reveal-icon field__reveal-icon--hide"}}
                </button>
            {{/if}}
        </span>
    {{/if}}
    {{#if props.hint}}<p class="field__hint" id="{{props.id}}-hint">{{props.hint}}</p>{{/if}}
    <p class="field__error" id="{{props.id}}-error" {{#unless props.error}}hidden{{/unless}}>
        {{> components/Icon/Icon name="alert" class="field__error-icon"}}
        <span data-field-error>{{props.error}}</span>
    </p>
    {{#if props.link}}<a class="field__link" href="{{props.link.url}}">{{props.link.text}}</a>{{/if}}
</div>
