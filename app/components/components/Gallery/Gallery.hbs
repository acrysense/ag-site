{{!--
	Фотогалерея — карусель фото (Figma: галерея в новости, 4652:12790; 1040×500, стрелки,
	точки на фото). props: label, slides [{ src, srcset, alt, caption }]. Одно фото — без стрелок
	и точек, пусто — блока нет. Пропорция фиксирована, любое фото обрезается по cover.
--}}
{{#if props.slides.length}}
    <section class="gallery carousel" aria-roledescription="карусель" aria-label="{{default props.label 'Фотографии'}}" data-module="Carousel" data-path="components" data-carousel-loop>
        <div class="carousel__track gallery__track" data-carousel-track>
            {{#each props.slides}}
                <figure class="carousel__slide gallery__slide" role="group" aria-roledescription="слайд" aria-label="{{add @index 1}} из {{../props.slides.length}}">
                    <img class="gallery__image" src="{{src}}" {{#if srcset}}srcset="{{srcset}}" sizes="(min-width: 1024px) 1040px, 100vw"{{/if}} width="1040" height="500" alt="{{alt}}" loading="lazy" decoding="async" />
                    {{#if caption}}<figcaption class="gallery__caption">{{caption}}</figcaption>{{/if}}
                </figure>
            {{/each}}
        </div>
        {{#if props.slides.[1]}}
            <button class="gallery__arrow gallery__arrow--prev" type="button" aria-label="Предыдущее фото" data-carousel-prev>
                {{> components/Icon/Icon name="angle-right" class="gallery__arrow-icon"}}
            </button>
            <button class="gallery__arrow gallery__arrow--next" type="button" aria-label="Следующее фото" data-carousel-next>
                {{> components/Icon/Icon name="angle-right" class="gallery__arrow-icon"}}
            </button>
            <div class="carousel__dots gallery__dots" data-carousel-dots></div>
        {{/if}}
    </section>
{{/if}}
