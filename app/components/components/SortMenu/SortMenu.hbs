{{!--
	Сортировка списка: текущий порядок текстом со стрелкой («Новые в начале ⌄»), по клику —
	список вариантов как у поля-выбора «По алфавиту» в поиске. До 768 — нижний лист с заголовком
	и затемнением. Пункты — обычные ссылки (GET с параметром сортировки), текущий отмечен.
	Новости, журнал, вакансии.
	props: id, label («Сортировка» — заголовок листа и подпись для скринридера), options [{ text,
	url, current }]. Один вариант — меню не нужно, выводится просто текст.
	Контракт — docs/contracts/news-list.md.
--}}
{{#if props.options.[1]}}
    <div class="sort-menu{{#if props.class}} {{props.class}}{{/if}}" data-module="SortMenu" data-path="components">
        <button class="sort-menu__toggle" type="button" aria-expanded="false" aria-haspopup="true" aria-controls="{{default props.id 'sort-menu'}}">
            <span class="visually-hidden">{{default props.label "Сортировка"}}: </span>
            {{#each props.options}}{{#if current}}{{text}}{{/if}}{{/each}}
            {{> components/Icon/Icon name="chevron-down" class="sort-menu__arrow"}}
        </button>
        <div class="sort-menu__backdrop" data-sort-menu-close hidden></div>
        <div class="sort-menu__popup" id="{{default props.id 'sort-menu'}}" hidden>
            <div class="sort-menu__head">
                <p class="sort-menu__title">{{default props.label "Сортировка"}}</p>
                <button class="sort-menu__close" type="button" aria-label="Закрыть" data-sort-menu-close>
                    {{> components/Icon/Icon name="close" class="sort-menu__close-icon"}}
                </button>
            </div>
            <ul class="sort-menu__list" role="list">
                {{#each props.options}}
                    <li><a class="sort-menu__option" href="{{url}}" {{#if current}}aria-current="true"{{/if}}>{{text}}{{#if current}}{{> components/Icon/Icon name="check" class="sort-menu__check"}}{{/if}}</a></li>
                {{/each}}
            </ul>
        </div>
    </div>
{{else if props.options.[0]}}
    <span class="sort-menu__current{{#if props.class}} {{props.class}}{{/if}}">{{props.options.[0].text}}</span>
{{/if}}
