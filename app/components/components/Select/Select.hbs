{{!--
	Выпадающий список с подписью внутри поля (Figma: Select — Месяц, 4704:1079). Нативный
	<select> прозрачный поверх: список — системный, работает с клавиатуры и на телефоне;
	шрифт у него 16px, чтобы iOS не увеличивал страницу. Видимое значение — копия, её
	обновляет JS. props: label, name, id, options [{ value, text, selected }], submit —
	отправлять форму при выборе, class.
--}}
<label class="select{{#if props.class}} {{props.class}}{{/if}}" data-module="Select" data-path="components">
    {{#if props.label}}<span class="select__label">{{props.label}}</span>{{/if}}
    <span class="select__value" aria-hidden="true" data-select-value>{{#each props.options}}{{#if selected}}{{text}}{{/if}}{{/each}}</span>
    <select class="select__control" name="{{props.name}}" {{#if props.id}}id="{{props.id}}"{{/if}} {{#if props.submit}}data-select-submit{{/if}}>
        {{#each props.options}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{text}}</option>
        {{/each}}
    </select>
    {{> components/Icon/Icon name="chevron-down" class="select__icon"}}
</label>
