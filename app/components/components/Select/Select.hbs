{{!--
	Выпадающий список с подписью внутри поля (например, «Месяц»). Основа — нативный <select>:
	без JS работает системный список. JS заменяет его своим списком (ARIA combobox + listbox,
	клавиатура) и пишет выбор обратно в <select> — форма и отправка не меняются.
	Контракт — docs/contracts/select.md.
	props: label, name, id, options [{ value, text, selected }], submit — отправлять форму при
	выборе, search — поиск по пунктам, url — пункты с сервера (порциями, с поиском; в options
	тогда только выбранный), minChars — с какой длины искать на сервере (по умолчанию 2),
	searchPlaceholder, sheetTitle — заголовок нижнего листа до 768 (иначе подпись поля), class.
	Фильтры (поиск): placeholder — серый текст, пока ничего не выбрано
	(«Должность»); multiple — выбор нескольких: список не закрывается, в поле «Отдел: 2»,
	с submit форма отправляется один раз — при закрытии списка; valueText — текст поля до JS.
--}}
<div
    class="select{{#if props.class}} {{props.class}}{{/if}}"
    data-module="Select"
    data-path="components"
    {{#if props.url}}data-select-url="{{props.url}}"{{/if}}
    {{#if (or props.search props.url)}}data-select-search{{/if}}
    {{#if props.minChars}}data-select-min-chars="{{props.minChars}}"{{/if}}
    {{#if props.searchPlaceholder}}data-select-search-placeholder="{{props.searchPlaceholder}}"{{/if}}
    {{#if props.sheetTitle}}data-select-sheet-title="{{props.sheetTitle}}"{{/if}}
>
    <label class="select__field">
        {{#if props.label}}<span class="select__label">{{props.label}}</span>{{/if}}
        <span class="select__value" aria-hidden="true" data-select-value {{#if props.placeholder}}data-placeholder="{{props.placeholder}}"{{/if}}>{{#if props.multiple}}{{default props.valueText props.placeholder}}{{else}}{{#each props.options}}{{#if selected}}{{text}}{{/if}}{{/each}}{{/if}}</span>
        <select class="select__control" name="{{props.name}}" {{#if props.id}}id="{{props.id}}"{{/if}} {{#if props.multiple}}multiple{{/if}} {{#if props.submit}}data-select-submit{{/if}}>
            {{#each props.options}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{text}}</option>
            {{/each}}
        </select>
        {{> components/Icon/Icon name="chevron-down" class="select__icon"}}
    </label>
</div>
